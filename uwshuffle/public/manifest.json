{
  "manifest_version": 3,
  "name": "UW Shuffle — making Quest easier to use",
  "short_name": "UWShuffle",
  "version": "1.0.0",
  "description": "Be able to preview your schedule while you swap and pick courses on Quest.",
  "author": "Jacob Fu",
  "homepage_url": "https://uwshuffle.com",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["scripting", "activeTab", "storage"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "UW Shuffle"
  },

  "host_permissions": [
    "https://quest.pecs.uwaterloo.ca/*",
    "https://uwflow.com/graphql"
  ],

  "content_scripts": [
    {
      "matches": ["https://quest.pecs.uwaterloo.ca/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "assets/*", "*.css", "*.js"],
      "matches": ["https://quest.pecs.uwaterloo.ca/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://uwflow.com https://quest.pecs.uwaterloo.ca https://*.supabase.co;"
  },

  "minimum_chrome_version": "88"
}
